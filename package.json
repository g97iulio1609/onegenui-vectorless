{
  "name": "@onegenui/vectorless",
  "version": "3.0.0",
  "description": "OneGenUI adapter for Vectorless - AI-powered document structure extraction",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vectorless": "./dist/cli/index.js",
    "vectorless-mcp": "./dist/mcp/entry.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools.js",
      "types": "./dist/tools.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@onegenui/deep-agents": "workspace:*",
    "ai": "^6.0.68",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "officegen": "^0.6.5",
    "pdf-parse": "^1.1.1",
    "pptx2json": "^0.0.10",
    "vectorless": "workspace:*",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@onegenui/mcp": "workspace:*",
    "@onegenui/providers": "workspace:*",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@openrouter/ai-sdk-provider": "^0.0.5",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}